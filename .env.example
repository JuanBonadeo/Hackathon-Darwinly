# Database (Neon PostgreSQL - use the pooler URL for serverless)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&channel_binding=require"

# Better Auth
BETTER_AUTH_URL="https://your-app.vercel.app"
BETTER_AUTH_SECRET="generate-with: openssl rand -base64 32"

# Google OAuth (update Authorized Redirect URIs in Google Console for production)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub (for API calls)
GITHUB_TOKEN=""

# External APIs
NYT_API_KEY=""
NYT_API_SECRET_KEY=""
TMDB_API_KEY=""
OPENALEX_API_KEY=""
CORE_API_KEY=""
GEMINI_API_KEY=""
GUARDIAN_API_KEY=""
COINMARKETCAP_API_KEY=""
